{
  "_comment": "Stateless evaluation (no session variables). Source: LatexCalculatorTest, MathfieldInputTest, CalculatorControllerTest. Optional keys in `expect`: latex, result, input, unit, quantityName, value (numeric string, compared as a decimal), valueSignificantDigits, resultStartsWith. Optional key `precision` overrides the default of 50. Error cases use `error` (exact message) or `errorContains`.",
  "cases": [
    {
      "name": "milestone",
      "latex": "F = 2kg \\cdot 10\\frac{m}{s^2}",
      "expect": {
        "latex": "F = 20\\,\\mathrm{N}",
        "result": "20\\,\\mathrm{N}",
        "input": "F = 2\\,\\mathrm{kg} \\cdot 10\\,\\frac{\\mathrm{m}}{\\mathrm{s}^{2}}",
        "value": "20",
        "unit": "N",
        "quantityName": "force"
      }
    },
    { "name": "spec reference example", "latex": "1\\,\\mathrm{kg} \\times 1\\,\\mathrm{m/s^2}", "expect": { "latex": "1\\,\\mathrm{N}" } },

    { "name": "weight force", "latex": "2kg \\cdot 9{,}81\\frac{m}{s^2}", "expect": { "latex": "19{,}62\\,\\mathrm{N}" } },
    { "name": "kinetic energy", "latex": "E = \\frac{1}{2} \\cdot 2kg \\cdot (3\\frac{m}{s})^2", "expect": { "latex": "E = 9\\,\\mathrm{J}" } },
    { "name": "ohm's law", "latex": "U = 5\\Omega \\cdot 2A", "expect": { "latex": "U = 10\\,\\mathrm{V}" } },
    { "name": "pressure", "latex": "P = \\frac{100N}{2m^2}", "expect": { "latex": "P = 50\\,\\mathrm{Pa}" } },
    { "name": "unit conversion in addition", "latex": "2kg + 500g", "expect": { "latex": "2{,}5\\,\\mathrm{kg}" } },

    {
      "name": "compound result keeps its unit and gets a quantity name",
      "latex": "v_1 = \\frac{100m}{8s}",
      "expect": { "result": "12{,}5\\,\\frac{\\mathrm{m}}{\\mathrm{s}}", "quantityName": "velocity" }
    },

    {
      "name": "precision 50: one third",
      "latex": "\\frac{1m}{3}",
      "precision": 50,
      "expect": { "resultStartsWith": "0{,}333333333333333333333333333333333333333333333333", "valueSignificantDigits": 50 }
    },
    { "name": "precision 6: root of two", "latex": "\\sqrt{2}m", "precision": 6, "expect": { "result": "1{,}41421\\,\\mathrm{m}" } },

    { "name": "scientific notation", "latex": "1kg \\cdot (299792458\\frac{m}{s})^2", "expect": { "result": "8{,}9875517873681764 \\cdot 10^{16}\\,\\mathrm{J}" } },

    {
      "name": "celsius survives the round trip",
      "latex": "20°C + 5°C",
      "expect": { "input": "20\\,^\\circ\\mathrm{C} + 5\\,^\\circ\\mathrm{C}", "result": "25\\,^\\circ\\mathrm{C}" }
    },

    { "name": "mathfield: frac12 evaluates", "latex": "\\frac12", "expect": { "result": "0{,}5" } },
    { "name": "mathfield: sqrt only covers the 4", "latex": "\\sqrt4m^2", "expect": { "result": "2\\,\\mathrm{m}^{2}" } },
    { "name": "mathfield: sqrt over a unit power", "latex": "\\sqrt{4m^2}", "expect": { "result": "2\\,\\mathrm{m}" } },
    {
      "name": "mathfield: operatorname milestone",
      "latex": "2\\operatorname{kg}\\cdot10\\frac{\\operatorname{m}}{\\operatorname{s}^2}",
      "expect": { "result": "20\\,\\mathrm{N}" }
    },
    {
      "name": "mathfield: typed milestone",
      "latex": "F=2\\operatorname{kg}\\cdot10\\frac{\\operatorname{m}}{\\operatorname{s}^2}",
      "expect": { "latex": "F = 20\\,\\mathrm{N}" }
    },

    { "name": "error: dimension mismatch", "latex": "1m + 1s", "error": "Incompatible units: m (length) and s (time) cannot be added." },
    { "name": "error: celsius plus kelvin", "latex": "20°C + 5K", "errorContains": "zero point of its own" },
    { "name": "error: undefined variable", "latex": "v_1 \\cdot 2s", "errorContains": "v_1" },

    {"name": "binom", "latex": "\\binom{5}{2}", "expect": {"value": "10"}},
    {"name": "binom k above n", "latex": "\\binom{2}{5}", "expect": {"value": "0"}},
    {"name": "binom large is exact", "latex": "\\binom{60}{30}", "expect": {"value": "118264581564861424"}},
    {"name": "error: binom negative", "latex": "\\binom{-1}{2}", "errorContains": "non-negative whole numbers"},
    {"name": "abs of negative", "latex": "|-3|", "expect": {"value": "3"}},
    {"name": "abs keeps the unit", "latex": "|2m - 5m|", "expect": {"value": "3", "unit": "m"}},
    {"name": "abs of pi minus 4", "latex": "|\\pi - 4|", "expect": {"resultStartsWith": "0{,}8584073464102"}},
    {"name": "implicit product with abs", "latex": "2|-4|", "expect": {"value": "8"}},
    {"name": "abs with left right", "latex": "\\left|-2\\right| + \\lvert -3\\rvert", "expect": {"value": "5"}},
    {"name": "abs nested through brackets", "latex": "|1 - (|{-2}|)|", "expect": {"value": "1"}},
    {"name": "degrees are pi over 180", "latex": "180^\\circ", "expect": {"resultStartsWith": "3{,}14159265358979"}},
    {"name": "degrees in braces", "latex": "90^{\\circ} \\cdot 2", "expect": {"resultStartsWith": "3{,}14159265358979"}},
    {"name": "error: degrees of a quantity", "latex": "30m^\\circ", "errorContains": "plain number"},

    {"name": "sin 0", "latex": "\\sin 0", "expect": {"value": "0"}},
    {"name": "cos 0", "latex": "\\cos 0", "expect": {"value": "1"}},
    {"name": "sin pi over 6 is exact", "latex": "\\sin\\frac{\\pi}{6}", "expect": {"value": "0.5"}},
    {"name": "sin 30 degrees", "latex": "\\sin 30^\\circ", "expect": {"value": "0.5"}},
    {"name": "cos 60 degrees", "latex": "\\cos 60^\\circ", "expect": {"value": "0.5"}},
    {"name": "cos 90 degrees", "latex": "\\cos 90^\\circ", "expect": {"value": "0"}},
    {"name": "sin 210 degrees", "latex": "\\sin 210^\\circ", "expect": {"value": "-0.5"}},
    {"name": "tan 45 degrees", "latex": "\\tan 45^\\circ", "expect": {"value": "1"}},
    {"name": "tan 135 degrees", "latex": "\\tan 135^\\circ", "expect": {"value": "-1"}},
    {"name": "sin 1 radian", "latex": "\\sin 1", "expect": {"resultStartsWith": "0{,}84147098480789650665"}},
    {"name": "cos 1 radian", "latex": "\\cos 1", "expect": {"resultStartsWith": "0{,}54030230586813971740"}},
    {"name": "tan 1 radian", "latex": "\\tan 1", "expect": {"resultStartsWith": "1{,}5574077246549022305"}},
    {"name": "sin 40 degrees", "latex": "\\sin 40^\\circ", "expect": {"resultStartsWith": "0{,}6427876096865393263"}},
    {"name": "sin squared", "latex": "\\sin^2 30^\\circ", "expect": {"value": "0.25"}},
    {"name": "product of two functions", "latex": "\\sin 30^\\circ \\cos 60^\\circ", "expect": {"value": "0.25"}},
    {"name": "coefficient", "latex": "2\\sin 30^\\circ", "expect": {"value": "1"}},
    {"name": "bracket argument is exact", "latex": "\\sin(30^\\circ) \\cdot 4", "expect": {"value": "2"}},
    {"name": "bracket argument then factor", "latex": "\\sin(0)5", "expect": {"value": "0"}},
    {"name": "ln 1", "latex": "\\ln 1", "expect": {"value": "0"}},
    {"name": "ln e", "latex": "\\ln e", "expect": {"value": "1"}},
    {"name": "ln e squared", "latex": "\\ln e^2", "expect": {"value": "2"}},
    {"name": "ln 2", "latex": "\\ln 2", "expect": {"resultStartsWith": "0{,}69314718055994530941"}},
    {"name": "log 1000", "latex": "\\log 1000", "expect": {"value": "3"}},
    {"name": "log one tenth", "latex": "\\log\\frac{1}{10}", "expect": {"value": "-1"}},
    {"name": "log 2", "latex": "\\log 2", "expect": {"resultStartsWith": "0{,}30102999566398119521"}},
    {"name": "sin of sum", "latex": "\\sin(\\pi/2 + 0)", "expect": {"value": "1"}},
    {"name": "error: sin of a length", "latex": "\\sin 2m", "errorContains": "plain number"},
    {"name": "error: ln of zero", "latex": "\\ln 0", "errorContains": "positive numbers"},
    {"name": "error: ln of a negative", "latex": "\\ln(-1)", "errorContains": "positive numbers"},
    {"name": "error: tan at 90 degrees", "latex": "\\tan 90^\\circ", "errorContains": "undefined"},
    {"name": "error: log with a base", "latex": "\\log_2 8", "errorContains": "not supported"},
    {"name": "error: inverse by exponent", "latex": "\\sin^{-1} 1", "errorContains": "not supported"},
    {"name": "error: function without argument", "latex": "\\sin", "errorContains": "missing its argument"},
    {"name": "error: function followed by function", "latex": "\\sin\\cos 1", "errorContains": "missing its argument"},

    {"name": "error: free variable has no value", "latex": "x^2 - 5x + 6", "errorContains": "The variable x has no value"},
    {"name": "error: free greek variable", "latex": "2\\theta", "errorContains": "The variable \\theta has no value"},
    {"name": "units still win over letters", "latex": "5m + 2m", "expect": {"value": "7", "unit": "m"}},

    {"name": "sum of squares", "latex": "\\sum_{i=1}^{4} i^2", "expect": {"value": "30"}},
    {"name": "sum with index named i", "latex": "\\sum_{i=1}^{3} i", "expect": {"value": "6"}},
    {"name": "sum then plus", "latex": "\\sum_{k=1}^{3} k + 1", "expect": {"value": "7"}},
    {"name": "sum of a product", "latex": "\\sum_{k=1}^{3} k \\cdot 2", "expect": {"value": "12"}},
    {"name": "empty sum is zero", "latex": "\\sum_{k=3}^{1} k", "expect": {"value": "0"}},
    {"name": "geometric sum", "latex": "\\sum_{n=0}^{10} 2^n", "expect": {"value": "2047"}},
    {"name": "sum keeps units", "latex": "\\sum_{k=1}^{3} k\\,m", "expect": {"value": "6", "unit": "m"}},
    {"name": "nested sums", "latex": "\\sum_{a=1}^{2}\\sum_{b=1}^{3} a b", "expect": {"value": "18"}},
    {"name": "error: sum limit with a unit", "latex": "\\sum_{k=1}^{3m} k", "errorContains": "plain number"},
    {"name": "error: sum too long", "latex": "\\sum_{k=1}^{2000000} k", "errorContains": "limited to"},
    {"name": "integral of x squared", "latex": "\\int_0^1 x^2 \\, dx", "expect": {"value": "0.333333333333333333333333333333"}},
    {"name": "integral of 2x", "latex": "\\int_{0}^{3} 2x\\,dx", "expect": {"value": "9"}},
    {"name": "integral of sin over 0..pi", "latex": "\\int_0^{\\pi} \\sin x \\, dx", "expect": {"resultStartsWith": "2"}},
    {"name": "integral of 1 over x", "latex": "\\int_1^2 \\frac{1}{x} dx", "expect": {"resultStartsWith": "0{,}693147180559945309417232121458"}},
    {"name": "integral with a singular end", "latex": "\\int_0^1 \\ln x \\, dx", "expect": {"resultStartsWith": "-1"}},
    {"name": "integral of inverse sqrt", "latex": "\\int_0^1 \\frac{1}{\\sqrt{x}} dx", "expect": {"resultStartsWith": "2"}},
    {"name": "reversed limits negate", "latex": "\\int_3^0 2x\\,dx", "expect": {"value": "-9"}},
    {"name": "equal limits give zero", "latex": "\\int_2^2 x\\,dx", "expect": {"value": "0"}},
    {"name": "nested integral", "latex": "\\int_0^1\\int_0^2 x y \\, dx\\, dy", "expect": {"value": "1"}},
    {"name": "integral with units", "latex": "\\int_0^{2m} 3\\frac{N}{m} x\\,dx", "expect": {"value": "6", "unit": "J"}},
    {"name": "integral variable named like a unit", "latex": "\\int_0^2 t\\,dt", "expect": {"value": "2"}},
    {"name": "mathrm differential", "latex": "\\int_0^2 x\\,\\mathrm{d}x", "expect": {"value": "2"}},
    {"name": "limit sin x over x", "latex": "\\lim_{x \\to 0} \\frac{\\sin x}{x}", "expect": {"value": "1"}},
    {"name": "limit of a removable gap", "latex": "\\lim_{x \\to 1} \\frac{x^2 - 1}{x - 1}", "expect": {"value": "2"}},
    {"name": "limit gives e", "latex": "\\lim_{x \\to 0} (1 + x)^{1/x}", "expect": {"resultStartsWith": "2{,}7182818284590452353602874713526624977572470"}},
    {"name": "limit by substitution", "latex": "\\lim_{x \\to 2} x^2", "expect": {"value": "4"}},
    {"name": "error: diverging limit", "latex": "\\lim_{x \\to 0} \\frac{1}{x^2}", "errorContains": "does not exist"},
    {"name": "error: one-sided mismatch", "latex": "\\lim_{x \\to 0} \\frac{|x|}{x}", "errorContains": "does not exist"},
    {"name": "error: integral without differential", "latex": "\\int_0^1 x", "errorContains": "missing its differential"}
  ]
}
