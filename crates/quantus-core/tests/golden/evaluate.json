    {"name": "error: sum limit with a unit", "latex": "\\sum_{k=1}^{3m} k", "errorContains": "plain number"},
    {"name": "error: sum too long", "latex": "\\sum_{k=1}^{2000000} k", "errorContains": "limited to"},
