{
  "_comment": "Stateless evaluation (no session variables). Source: LatexCalculatorTest, MathfieldInputTest, CalculatorControllerTest. Optional keys in `expect`: latex, result, input, unit, quantityName, value (numeric string, compared as a decimal), valueSignificantDigits, resultStartsWith. Optional key `precision` overrides the default of 50. Error cases use `error` (exact message) or `errorContains`.",
  "cases": [
    {
      "name": "milestone",
      "latex": "F = 2kg \\cdot 10\\frac{m}{s^2}",
      "expect": {
        "latex": "F = 20\\,\\mathrm{N}",
        "result": "20\\,\\mathrm{N}",
        "input": "F = 2\\,\\mathrm{kg} \\cdot 10\\,\\frac{\\mathrm{m}}{\\mathrm{s}^{2}}",
        "value": "20",
        "unit": "N",
        "quantityName": "force"
      }
    },
    { "name": "spec reference example", "latex": "1\\,\\mathrm{kg} \\times 1\\,\\mathrm{m/s^2}", "expect": { "latex": "1\\,\\mathrm{N}" } },

    { "name": "weight force", "latex": "2kg \\cdot 9{,}81\\frac{m}{s^2}", "expect": { "latex": "19{,}62\\,\\mathrm{N}" } },
    { "name": "kinetic energy", "latex": "E = \\frac{1}{2} \\cdot 2kg \\cdot (3\\frac{m}{s})^2", "expect": { "latex": "E = 9\\,\\mathrm{J}" } },
    { "name": "ohm's law", "latex": "U = 5\\Omega \\cdot 2A", "expect": { "latex": "U = 10\\,\\mathrm{V}" } },
    { "name": "pressure", "latex": "P = \\frac{100N}{2m^2}", "expect": { "latex": "P = 50\\,\\mathrm{Pa}" } },
    { "name": "unit conversion in addition", "latex": "2kg + 500g", "expect": { "latex": "2{,}5\\,\\mathrm{kg}" } },

    {
      "name": "compound result keeps its unit and gets a quantity name",
      "latex": "v_1 = \\frac{100m}{8s}",
      "expect": { "result": "12{,}5\\,\\frac{\\mathrm{m}}{\\mathrm{s}}", "quantityName": "velocity" }
    },

    {
      "name": "precision 50: one third",
      "latex": "\\frac{1m}{3}",
      "precision": 50,
      "expect": { "resultStartsWith": "0{,}333333333333333333333333333333333333333333333333", "valueSignificantDigits": 50 }
    },
    { "name": "precision 6: root of two", "latex": "\\sqrt{2}m", "precision": 6, "expect": { "result": "1{,}41421\\,\\mathrm{m}" } },

    { "name": "scientific notation", "latex": "1kg \\cdot (299792458\\frac{m}{s})^2", "expect": { "result": "8{,}9875517873681764 \\cdot 10^{16}\\,\\mathrm{J}" } },

    {
      "name": "celsius survives the round trip",
      "latex": "20°C + 5°C",
      "expect": { "input": "20\\,^\\circ\\mathrm{C} + 5\\,^\\circ\\mathrm{C}", "result": "25\\,^\\circ\\mathrm{C}" }
    },

    { "name": "mathfield: frac12 evaluates", "latex": "\\frac12", "expect": { "result": "0{,}5" } },
    { "name": "mathfield: sqrt only covers the 4", "latex": "\\sqrt4m^2", "expect": { "result": "2\\,\\mathrm{m}^{2}" } },
    { "name": "mathfield: sqrt over a unit power", "latex": "\\sqrt{4m^2}", "expect": { "result": "2\\,\\mathrm{m}" } },
    {
      "name": "mathfield: operatorname milestone",
      "latex": "2\\operatorname{kg}\\cdot10\\frac{\\operatorname{m}}{\\operatorname{s}^2}",
      "expect": { "result": "20\\,\\mathrm{N}" }
    },
    {
      "name": "mathfield: typed milestone",
      "latex": "F=2\\operatorname{kg}\\cdot10\\frac{\\operatorname{m}}{\\operatorname{s}^2}",
      "expect": { "latex": "F = 20\\,\\mathrm{N}" }
    },

    { "name": "error: dimension mismatch", "latex": "1m + 1s", "error": "Incompatible units: m (length) and s (time) cannot be added." },
    {"name": "celsius as results are written", "latex": "160\\,^\\circ\\mathrm{C}", "expect": {"result": "160\\,^\\circ\\mathrm{C}", "quantityName": "temperature"}},
    {"name": "negative celsius with text", "latex": "-41^{\\circ}\\text{C}", "expect": {"result": "-41\\,^\\circ\\mathrm{C}"}},
    {"name": "celsius with a bare C", "latex": "25^\\circ C + 5^\\circ C", "expect": {"result": "30\\,^\\circ\\mathrm{C}"}},
    {"name": "one-character celsius sign", "latex": "20\u2103", "expect": {"result": "20\\,^\\circ\\mathrm{C}"}},
    {"name": "degrees stay angles", "latex": "\\sin 30^\\circ", "expect": {"value": "0.5"}},
    {"name": "signed function argument", "latex": "\\sin -30^\\circ", "expect": {"value": "-0.5"}},
    {"name": "signed arguments in a sum", "latex": "\\sin^2 -30^\\circ + \\cos^2 -30^\\circ", "expect": {"value": "1"}},
    {"name": "square brackets group", "latex": "\\left[7 + 3\\right] \\cdot 4", "expect": {"value": "40"}},
    {"name": "escaped curly brackets group", "latex": "\\{ 2 + 3 \\} \\cdot 4", "expect": {"value": "20"}},
    {"name": "typographic minus", "latex": "12 \u2212 17", "expect": {"value": "-5"}},
    {"name": "division sign", "latex": "12 \u00f7 4", "expect": {"value": "3"}},
    {"name": "dot operator", "latex": "3 \u22c5 4", "expect": {"value": "12"}},
    { "name": "error: celsius plus kelvin", "latex": "20°C + 5K", "errorContains": "zero point of its own" },
    { "name": "error: undefined variable", "latex": "v_1 \\cdot 2s", "errorContains": "v_1" },

    {"name": "binom", "latex": "\\binom{5}{2}", "expect": {"value": "10"}},
    {"name": "binom k above n", "latex": "\\binom{2}{5}", "expect": {"value": "0"}},
    {"name": "binom large is exact", "latex": "\\binom{60}{30}", "expect": {"value": "118264581564861424"}},
    {"name": "error: binom negative", "latex": "\\binom{-1}{2}", "errorContains": "non-negative whole numbers"},
    {"name": "abs of negative", "latex": "|-3|", "expect": {"value": "3"}},
    {"name": "abs keeps the unit", "latex": "|2m - 5m|", "expect": {"value": "3", "unit": "m"}},
    {"name": "abs of pi minus 4", "latex": "|\\pi - 4|", "expect": {"resultStartsWith": "0{,}8584073464102"}},
    {"name": "implicit product with abs", "latex": "2|-4|", "expect": {"value": "8"}},
    {"name": "abs with left right", "latex": "\\left|-2\\right| + \\lvert -3\\rvert", "expect": {"value": "5"}},
    {"name": "abs nested through brackets", "latex": "|1 - (|{-2}|)|", "expect": {"value": "1"}},
    {"name": "degrees are pi over 180", "latex": "180^\\circ", "expect": {"resultStartsWith": "3{,}14159265358979"}},
    {"name": "degrees in braces", "latex": "90^{\\circ} \\cdot 2", "expect": {"resultStartsWith": "3{,}14159265358979"}},
    {"name": "error: degrees of a quantity", "latex": "30m^\\circ", "errorContains": "plain number"},

    {"name": "sin 0", "latex": "\\sin 0", "expect": {"value": "0"}},
    {"name": "cos 0", "latex": "\\cos 0", "expect": {"value": "1"}},
    {"name": "sin pi over 6 is exact", "latex": "\\sin\\frac{\\pi}{6}", "expect": {"value": "0.5"}},
    {"name": "sin 30 degrees", "latex": "\\sin 30^\\circ", "expect": {"value": "0.5"}},
    {"name": "cos 60 degrees", "latex": "\\cos 60^\\circ", "expect": {"value": "0.5"}},
    {"name": "cos 90 degrees", "latex": "\\cos 90^\\circ", "expect": {"value": "0"}},
    {"name": "sin 210 degrees", "latex": "\\sin 210^\\circ", "expect": {"value": "-0.5"}},
    {"name": "tan 45 degrees", "latex": "\\tan 45^\\circ", "expect": {"value": "1"}},
    {"name": "tan 135 degrees", "latex": "\\tan 135^\\circ", "expect": {"value": "-1"}},
    {"name": "sin pi is exactly zero", "latex": "\\sin \\pi", "expect": {"value": "0", "result": "0"}},
    {"name": "tan 180 degrees is exactly zero", "latex": "\\tan 180^\\circ", "expect": {"result": "0"}},
    {"name": "sin of a negative pi multiple", "latex": "\\sin\\frac{7\\pi}{6}", "expect": {"value": "-0.5"}},
    {"name": "root values cancel exactly", "latex": "\\sin\\frac{5\\pi}{3} \\cos\\frac{\\pi}{3} + \\cos\\frac{5\\pi}{3} \\sin\\frac{\\pi}{3}", "expect": {"result": "0"}},
    {"name": "square of sin 45 degrees", "latex": "\\sin^2 45^\\circ", "expect": {"result": "0{,}5"}},
    {"name": "pendulum period: root of mixed length units", "latex": "2 \\cdot \\pi \\cdot \\sqrt{\\frac{16\\,\\mathrm{cm}}{9{,}81\\,\\frac{\\mathrm{m}}{\\mathrm{s}^{2}}}}", "expect": {"unit": "s", "resultStartsWith": "0{,}8024266722842"}},
    {"name": "LC resonance: root of prefixed units", "latex": "\\frac{1}{2 \\pi \\sqrt{10\\,\\mathrm{mH} \\cdot 1\\,\\mathrm{\\mu F}}}", "expect": {"unit": "Hz", "resultStartsWith": "1591{,}549430918953"}},
    {"name": "cube root of a volume in litres", "latex": "\\sqrt[3]{8\\,\\mathrm{l}}", "expect": {"unit": "m", "value": "0.2"}},
    {"name": "electronvolts to joules", "latex": "2\\,\\mathrm{keV} + 0\\,\\mathrm{J}", "expect": {"unit": "keV", "value": "2"}},
    {"name": "atmosphere plus bar", "latex": "1\\,\\mathrm{atm} + 1\\,\\mathrm{bar}", "expect": {"unit": "atm", "resultStartsWith": "1{,}98692326671601"}},
    {"name": "kilowatt hours stay as written", "latex": "3\\,\\mathrm{kWh}", "expect": {"unit": "kWh", "value": "3"}},
    {"name": "kilowatt hours to joules", "latex": "\\frac{3\\,\\mathrm{kWh}}{1\\,\\mathrm{s}}", "expect": {"unit": "W", "value": "10800000"}},
    {"name": "percent of a quantity", "latex": "20\\,\\% \\cdot 50\\,\\mathrm{kg}", "expect": {"unit": "kg", "value": "10"}},
    {"name": "angstrom command", "latex": "5\\,\\mathrm{\\AA} + 1\\,\\mathrm{nm}", "expect": {"resultStartsWith": "15"}},
    {"name": "tonne in unit markup", "latex": "2\\,\\mathrm{t} + 500\\,\\mathrm{kg}", "expect": {"value": "2.5"}},
    {"name": "mph converts in a sum", "latex": "100\\,\\mathrm{mph} + 0\\,\\frac{\\mathrm{m}}{\\mathrm{s}}", "expect": {"value": "100", "unit": "mph"}},
    {"name": "mph in metres per second", "latex": "0\\,\\frac{\\mathrm{m}}{\\mathrm{s}} + 100\\,\\mathrm{mph}", "expect": {"value": "44.704"}},
