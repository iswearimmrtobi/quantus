# Waveshare ESP32-P4-Module-DEV-KIT: 16 MB flash, 32 MB PSRAM in the package.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
# The boot screen must not wait for a test of 32 MB.
CONFIG_SPIRAM_MEMTEST=n

CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_TASK_WDT_EN=n
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192

# Stop on a crash instead of restarting, so an out-of-memory abort shows once, not in a loop.
CONFIG_ESP_SYSTEM_PANIC_PRINT_HALT=y

# The SD card: long file names in UTF-8, so a wallpaper may be called "Sonnenuntergang über See".
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y

# Wi-Fi through the ESP32-C6 (ESP-Hosted over SDIO, firmware/docs/wlan.md). The transport, the
# slot and the pins are ESP-Hosted's defaults for the P4 with a C6, which the dev kit follows.
CONFIG_ESP_HOSTED_HOST_TRANSPORT_BUS_SDIO=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_HOST_RESET_GPIO=54
