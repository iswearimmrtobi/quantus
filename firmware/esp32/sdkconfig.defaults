# Waveshare ESP32-P4-Module-DEV-KIT: 16 MB flash, 32 MB PSRAM in the package.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
# The prompt must not wait for a test of 32 MB.
CONFIG_SPIRAM_MEMTEST=n

CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_TASK_WDT_EN=n
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192

# Stop on a crash instead of restarting, so an out-of-memory abort shows once, not in a loop.
CONFIG_ESP_SYSTEM_PANIC_PRINT_HALT=y
