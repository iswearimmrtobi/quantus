{
  "name": "quantus-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Quantus: an SI unit calculator as a desktop app (Tauri frontend for the Rust engine)",
  "author": "Tobias Schmidt",
  "scripts": {
    "dev": "tauri dev",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "tauri": "tauri",
    "bundle": "tauri build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "copy-fonts": "node scripts/copy-mathlive-fonts.mjs",
    "postinstall": "npm run copy-fonts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "katex": "^0.16.11",
    "mathlive": "^0.110.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/katex": "^0.16.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
