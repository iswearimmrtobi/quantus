{
  "name": "quantus-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Quantus — SI-Rechner als Desktop-App (Electron-Frontend zum Kotlin-Backend)",
  "author": "Tobias Schmidt",
  "main": "dist-electron/main.js",
  "desktopName": "quantus.desktop",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:app\"",
    "dev:renderer": "vite",
    "dev:app": "npm run build:main && electron . --dev-server",
    "build:main": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "dist": "npm run dist:backend && npm run build && electron-builder --linux AppImage",
    "dist:backend": "../gradlew -p .. desktopResources",
    "tauri": "tauri",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "icon": "rsvg-convert -w 512 -h 512 build/icon.svg -o build/icon.png",
    "copy-fonts": "node scripts/copy-mathlive-fonts.mjs",
    "postinstall": "npm run copy-fonts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "katex": "^0.16.11",
    "mathlive": "^0.110.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/katex": "^0.16.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "electron": "40.8.0",
    "electron-builder": "^26.15.7",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "electron@40.8.0": true,
    "esbuild@0.28.1": true
  }
}
