{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quantus",
  "version": "0.1.0",
  "identifier": "dev.tobifrosch.quantus",
  "build": {
    "beforeDevCommand": "npm run dev:renderer",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:renderer",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Quantus",
        "width": 1180,
        "height": 780,
        "backgroundColor": "#17161D"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Education",
    "copyright": "Tobias Schmidt",
    "shortDescription": "SI unit calculator with LaTeX input and output",
    "longDescription": "Calculator for physics that keeps SI units dimensionally consistent, takes LaTeX as input and returns the working as LaTeX.",
    "linux": {
      "deb": {
        "desktopTemplate": "packaging/quantus.desktop"
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
