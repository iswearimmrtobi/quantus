{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quantus",
  "version": "0.1.0",
  "identifier": "de.quantus.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:renderer",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:renderer",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Quantus",
        "width": 1180,
        "height": 780,
        "backgroundColor": "#17161D"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
